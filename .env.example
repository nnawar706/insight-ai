# Clerk authentication (see AGENTS.md section 21 for the full env var table)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Supabase (see AGENTS.md section 21 for the full env var table)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Oxylabs Web Scraper API + Scheduler (see AGENTS.md section 21)
OXY_WSA_USERNAME=
OXY_WSA_PASSWORD=

# Admin secret for action routes, sent as x-insight-ai-admin-secret (see AGENTS.md section 15)
INSIGHT_AI_ADMIN_SECRET=

# Gemini (Google Generative AI) for AI article analysis and embeddings (see
# prompts/007-ai-article-analysis-gemini.md and prompts/009-pgvector-related-articles.md;
# a deliberate deviation from AGENTS.md section 6/21's OpenAI default, per explicit project decision)
GEMINI_API_KEY=

# Optional; articles analyzed per batch (default 5, see AGENTS.md section 21)
ANALYSIS_BATCH_SIZE=
